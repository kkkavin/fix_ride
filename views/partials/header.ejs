<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Fix Ride - On-Demand Mechanic Booking' %></title>
  <meta name="description"
    content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Book a nearby mechanic in minutes. Fix Ride connects you with verified mechanics for roadside assistance and vehicle repair.' %>">
  <link rel="icon" type="image/svg+xml" href="/static/img/logo.svg?v=2.8">
  <link rel="stylesheet" href="/static/css/style.css?v=2.8">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <%- typeof extraCss !== 'undefined' ? extraCss : '' %>
</head>

<body>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer"></div>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="d-flex align-center gap-1">
      <!-- Hamburger Menu (Mobile) -->
      <button class="btn btn-secondary btn-sm" id="mobileMenuToggle" style="display:none; padding: 0.5rem; border:none; background:transparent;" title="Menu" onclick="toggleSidebar()">
        <span style="font-size:1.6rem; color:var(--text);">☰</span>
      </button>

      <a href="/" class="nav-logo" style="margin:0;">
        <img src="/static/img/logo.svg" alt="Fix Ride Logo" style="width: 28px; height: 28px;">
        Fix<span>Ride</span>
      </a>
    </div>

    <ul class="nav-links" id="navLinks">
      <li><a href="/#home">Home</a></li>
      <li><a href="/#features">Features</a></li>
      <li><a href="/#how-it-works">How It Works</a></li>
    </ul>

    <div class="nav-actions d-flex align-center gap-1">
      <button class="theme-toggle-icon" id="themeToggle" title="Toggle dark/light mode" aria-label="Toggle theme">
        <span class="theme-icon">☀️</span>
      </button>
      
      <div id="navAuthButtons" class="d-flex gap-1">
        <a href="/auth/login/" class="btn btn-secondary btn-sm">Login</a>
        <a href="/auth/register/" class="btn btn-primary btn-sm">Get Started</a>
      </div>
      
      <div id="navUserMenu" class="hidden d-flex align-center gap-1">
        <button class="logout-btn-premium" id="logoutBtn" onclick="logout()" title="Logout">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Dashboard Sidebar Toggle Overlay (Mobile only) -->
  <div id="sidebarOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1999;" onclick="toggleSidebar()"></div>

  <style>
    .theme-toggle-icon {
      background: none; border: none; cursor: pointer; font-size: 1.4rem; padding: 0.25rem;
      display: flex; align-items: center; justify-content: center; transition: transform 0.3s ease;
    }
    .theme-toggle-icon:hover { transform: rotate(15deg); }
    
    .logout-btn-premium {
      background: none; border: none; cursor: pointer; color: #ef4444;
      padding: 0.5rem; display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .logout-btn-premium:hover { color: #b91c1c; transform: translateX(3px); filter: drop-shadow(0 0 8px rgba(239,68,68,0.2)); }

    @media (max-width: 768px) {
      #mobileMenuToggle { display: block !important; }
      .nav-links { display: none; }
      .nav-actions { gap: 0.4rem; }
      .nav-logo { font-size: 1.25rem; }
    }
  </style>
